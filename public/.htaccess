<IfModule mod_headers.c>
    # Security headers
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # If existing file or directory, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route /api/* to the PHP API router
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]

    # Route /api to the PHP API router
    RewriteRule ^api$ api/index.php [L]

    # Serve frontend (SPA fallback)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

# PWA Cache Controls
<IfModule mod_headers.c>
    # Never cache service worker or index.html to guarantee instantaneous PWA updates
    <FilesMatch "^(index\.html|sw\.js|service-worker\.js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Correct MIME type and non-stale caching for Web App Manifest
    <FilesMatch "\.(webmanifest|manifest\.json)$">
        Header set Content-Type "application/manifest+json; charset=utf-8"
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Cache hashed build assets for performance
    <FilesMatch "\.(js|css|woff|woff2|ttf|otf|eot|png|jpg|jpeg|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
