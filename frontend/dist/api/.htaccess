<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /odera/api/

    # If request is for an existing file, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route everything else through index.php (PATH_INFO style)
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>
